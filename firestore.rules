rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin config - any authenticated user can read (needed for admin check)
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if false; // Only editable via Firebase Console
    }

    // User profile document - any authenticated user can read (for member listing)
    // Only the owner can write their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    // User goals subcollection - owner or admin
    match /users/{userId}/goals/{goalId} {
      allow read, write: if request.auth.uid == userId
        || isAdmin();
    }

    // Team bonus - any authenticated user can read, only admin can write
    match /teamBonus/{monthId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails;
    }
  }
}
