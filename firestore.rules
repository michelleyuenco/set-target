rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin config - read-only, only editable via Firebase Console
    match /config/admins {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // App settings - any authenticated user can read, only admin can write
    match /config/appSettings {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // User profile document - any authenticated user can read (for member listing)
    // Only the owner can write their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId || isAdmin();
    }

    // User goals subcollection - owner or admin
    match /users/{userId}/goals/{goalId} {
      allow read, write: if request.auth.uid == userId
        || isAdmin();
    }

    // Team bonus - any authenticated user can read, only admin can write
    match /teamBonus/{monthId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Monthly adjustments (misc salary items) - any authenticated user can read, only admin can write
    match /monthlyAdjustments/{monthId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Locations - any authenticated user can read, only admin can write
    match /locations/{locationId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Rosters - any authenticated user can read (filtering done on frontend)
    // Any authenticated user can write (admin manages roster, members can transfer shifts)
    match /rosters/{monthId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Shift applications subcollection under each roster month
    match /rosters/{monthId}/applications/{appId} {
      // Any authenticated user can read (matches parent roster read rule)
      allow read: if request.auth != null;

      // Members can create their own pending applications
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';

      // Members can delete (cancel) their own applications
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;

      // Admin can update any application (approve / reject).
      // Members can re-apply (update their own rejected application back to pending).
      // applyForShift uses setDoc which triggers 'update' when the doc already exists.
      allow update: if isAdmin()
        || (request.auth != null
            && resource.data.uid == request.auth.uid
            && resource.data.status == 'rejected'
            && request.resource.data.status == 'pending'
            && request.resource.data.uid == request.auth.uid);
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails;
    }
  }
}
