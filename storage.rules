rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // User proof images: any authenticated user can read/write
    // Admin check is handled at the application layer (UI gating)
    // Uploads are constrained by size (5 MB) and content type (images only)
    match /users/{userId}/shifts/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
