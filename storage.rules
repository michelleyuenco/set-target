rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/config/admins)
        && request.auth.token.email in firestore.get(/databases/(default)/documents/config/admins).data.emails;
    }

    // User proof images: owner or admin can read/write/delete
    match /users/{userId}/shifts/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if (request.auth.uid == userId || isAdmin())
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth.uid == userId || isAdmin();
    }
  }
}
